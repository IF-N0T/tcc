generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PERITO
  VISUALIZADOR
}

enum CaseStatus {
  EM_ANALISE
  AGUARDANDO_EVIDENCIAS
  EM_ELABORACAO_LAUDO
  CONCLUIDO
  ARQUIVADO
}

enum CasePriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum EvidenceCategory {
  FISICA
  DIGITAL
}

enum EvidenceType {
  SMARTPHONE
  NOTEBOOK
  COMPUTADOR
  HD
  SSD
  PENDRIVE
  CARTAO_MEMORIA
  OUTRO_FISICO
  IMAGEM_FORENSE
  ARQUIVO
  BANCO_DADOS
  LOG
  EMAIL
  DOCUMENTO
  CONVERSA
  METADADOS
  OUTRO_DIGITAL
}

enum HashAlgorithm {
  MD5
  SHA1
  SHA256
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PERITO)
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  lastSeenAt   DateTime?
  leftAt       DateTime?
  createdAt    DateTime @default(now())

  casesOwned    Case[]     @relation("CaseResponsible")
  auditLogs     AuditLog[]
  analyses      Analysis[]
  tasksAssigned Task[]
  reports       CaseReport[]
  caseNotes     CaseNote[]
  toolImports   ToolImport[]
  knowledge     KnowledgeEntry[]
}

model Case {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  description   String?
  status        CaseStatus   @default(EM_ANALISE)
  priority      CasePriority @default(MEDIA)
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  responsibleId String
  responsible   User         @relation("CaseResponsible", fields: [responsibleId], references: [id])
  notes         String?

  people        Person[]
  devices       Device[]
  evidences     Evidence[]
  findings      Finding[]
  tasks         Task[]
  events        CaseEvent[]
  analyses      Analysis[]
  relationships Relationship[]
  reports       CaseReport[]
  caseNotes     CaseNote[]
  toolImports   ToolImport[]
  importedItems ImportedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id       String  @id @default(cuid())
  code     String  @unique
  caseId   String
  case     Case    @relation(fields: [caseId], references: [id])
  name     String
  role     String?
  document String?
  email    String?
  phone    String?
  notes    String?
  devices  Device[]

  createdAt DateTime @default(now())
}

model Device {
  id           String       @id @default(cuid())
  code         String       @unique
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id])
  personId     String?
  person       Person?      @relation(fields: [personId], references: [id])
  type         EvidenceType
  brand        String?
  model        String?
  serialNumber String?
  imei         String?
  macAddress   String?
  notes        String?
  evidences    Evidence[]

  createdAt DateTime @default(now())
}

model Evidence {
  id              String           @id @default(cuid())
  code            String           @unique
  caseId          String
  case            Case             @relation(fields: [caseId], references: [id])
  category        EvidenceCategory
  type            EvidenceType
  description     String
  origin          String?
  collectedAt     DateTime?
  collectedById   String?
  collectionPlace String?
  state           String?
  size            String?
  format          String?
  serialNumber    String?
  technicalIds    String?
  notes           String?
  deviceId        String?
  device          Device?          @relation(fields: [deviceId], references: [id])

  hashes        EvidenceHash[]
  custodyEvents CustodyEvent[]
  findings      Finding[]
  analyses      Analysis[]
  toolImports   ToolImport[]
  importedItems ImportedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvidenceHash {
  id             String        @id @default(cuid())
  evidenceId     String
  evidence       Evidence      @relation(fields: [evidenceId], references: [id])
  algorithm      HashAlgorithm
  value          String
  calculatedAt   DateTime      @default(now())
  calculatedById String
  notes          String?
}

model CustodyEvent {
  id             String   @id @default(cuid())
  evidenceId     String
  evidence       Evidence @relation(fields: [evidenceId], references: [id])
  action         String
  fromCustodian  String?
  toCustodian    String
  location       String?
  reason         String?
  occurredAt     DateTime @default(now())
  registeredById String
  notes          String?
  createdAt      DateTime @default(now())
}

model Tool {
  id       String     @id @default(cuid())
  name     String
  vendor   String?
  version  String?
  analyses Analysis[]
  toolImports ToolImport[]
}

model Analysis {
  id            String    @id @default(cuid())
  code          String    @unique
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id])
  evidenceId    String
  evidence      Evidence  @relation(fields: [evidenceId], references: [id])
  type          String
  toolId        String?
  tool          Tool?     @relation(fields: [toolId], references: [id])
  performedById String
  performedBy   User      @relation(fields: [performedById], references: [id])
  procedure     String?
  result        String?
  conclusion    String?
  performedAt   DateTime  @default(now())
  findings      Finding[]

  createdAt DateTime @default(now())
}

model Finding {
  id           String    @id @default(cuid())
  code         String    @unique
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id])
  title        String
  description  String
  type         String?
  identifiedAt DateTime  @default(now())
  evidenceId   String?
  evidence     Evidence? @relation(fields: [evidenceId], references: [id])
  analysisId   String?
  analysis     Analysis? @relation(fields: [analysisId], references: [id])
  notes        String?

  createdAt DateTime @default(now())
}

model CaseEvent {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  title       String
  description String?
  category    String?
  occurredAt  DateTime

  createdAt DateTime @default(now())
}

model Relationship {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  sourceType String
  sourceId   String
  targetType String
  targetId   String
  label      String?

  createdAt DateTime @default(now())
}

model Task {
  id           String     @id @default(cuid())
  caseId       String
  case         Case       @relation(fields: [caseId], references: [id])
  title        String
  status       TaskStatus @default(PENDENTE)
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  evidenceId   String?
  findingId    String?
  dueDate      DateTime?

  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?

  createdAt DateTime @default(now())
}

model CaseReport {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  version   Int
  title     String
  format    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([caseId, version])
  @@index([caseId, createdAt])
}

// ---------------------------------------------------------------------------
// Diário do perito: anotações livres feitas durante o trabalho. O Watson usa
// essas notas como fonte (e cruza com os registros), sem acrescentar fatos.
// ---------------------------------------------------------------------------
model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// ---------------------------------------------------------------------------
// Biblioteca do Watson: procedimentos, normas, guias de ferramentas, checklists
// e modelos de texto. É conhecimento geral (não dados do caso) e sempre é
// exibido com a fonte, separado dos fatos registrados.
// ---------------------------------------------------------------------------
model KnowledgeEntry {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String
  content   String   @db.Text
  tags      String   @default("")
  appliesTo String   @default("")
  source    String?
  builtIn   Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// Importações de ferramentas (Autopsy, ImageJ, listas de hash, body file...).
// ---------------------------------------------------------------------------
model ToolImport {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidenceId   String?
  evidence     Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  toolId       String?
  tool         Tool?     @relation(fields: [toolId], references: [id], onDelete: SetNull)
  analysisId   String?
  source       String
  filename     String
  rowCount     Int
  summary      String?   @db.Text
  importedById String
  importedBy   User      @relation(fields: [importedById], references: [id])
  createdAt    DateTime  @default(now())

  items ImportedItem[]

  @@index([caseId, createdAt])
}

model ImportedItem {
  id         String     @id @default(cuid())
  importId   String
  toolImport ToolImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  caseId     String
  case       Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidenceId String?
  evidence   Evidence?  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  name       String
  path       String?
  size       String?
  md5        String?
  sha1       String?
  sha256     String?
  mime       String?
  modifiedAt DateTime?
  accessedAt DateTime?
  bornAt     DateTime?
  extra      String?    @db.Text

  @@index([importId])
  @@index([caseId])
  @@index([md5])
  @@index([sha1])
  @@index([sha256])
}
